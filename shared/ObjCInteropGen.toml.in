closure-depth = 0

[sources.foundation]
paths = ["@SDK@/System/Library/Frameworks/Foundation.framework/Headers/Foundation.h"]
arguments = ["-target", "@CLANG_TRIPLE@", "-isysroot", "@SDK@", "-I", "@RES_DIR@/include"@EXTRA_ARGS@]

[[packages]]
package-name = "@PACKAGE@"
filters = { include = ["NSObject|NSString|NSUUID"] }
output-path = "@OUTPUT_PATH@"
